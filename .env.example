# Copy this file to .env and edit. Precedence: a non-blank value here overrides
# the shell environment; a blank assignment (AI_API_KEY=) means "not set here"
# and leaves a shell value in place.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# Every provider is an OpenAI-compatible endpoint: base URL + API key + model.
# Use a built-in preset:
#   groq  nvidia  openai  openrouter  together  deepseek  mistral
#   cerebras  fireworks  perplexity  ollama
# ...or any custom name. A custom name needs NAME_BASE_URL (and usually a key).
#
# The CLI can override this per run: python -m src.main --provider groq
# Inside the REPL: /provider to list, /provider <name> to switch.
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# Local Ollama
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# ---------------------------------------------------------------------------
# Remote provider (the active one)
# ---------------------------------------------------------------------------
# Generic names apply to whichever provider LLM_PROVIDER selects. Provider-
# specific names (NVIDIA_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, ...) take
# precedence, so several providers can live in one .env.
#
# Example: NVIDIA NIM
# LLM_PROVIDER=nvidia
# AI_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_API_KEY=nvapi-...
# AI_MODEL=minimaxai/minimax-m3.1-flash
#
# Example: Groq
# LLM_PROVIDER=groq
# AI_API_KEY=gsk_...
# AI_MODEL=openai/gpt-oss-120b
#
# Example: self-hosted OpenAI-compatible server
# LLM_PROVIDER=myhost
# MYHOST_BASE_URL=http://192.168.1.20:8000/v1
# MYHOST_API_KEY=not-needed
# MYHOST_MODEL=my-model
#
# AI_BASE_URL is only required for presets you override or for custom providers.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional provider-specific overrides:
# NVIDIA_API_KEY=
# NVIDIA_BASE_URL=
# NVIDIA_MODEL=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# /model in the REPL switches at runtime; --model switches for the whole run.
# /model list asks the active provider for its real catalogue (GET /models).

# --- Token budget (generic; Groq's free tier is 8K tokens/minute) ---
# An oversized request is rejected outright, so these keep one turn in one bucket.
MAX_ITERATIONS=5
# One model call can request many tool calls; this caps executions per user turn.
MAX_TOOL_CALLS_PER_TURN=20
# Identical calls re-execute by default (results can differ); 1 restores replay.
DEDUPE_TOOL_CALLS=0
MAX_OUTPUT_TOKENS=1200
MAX_INPUT_TOKENS=6500
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Caps applied before each request: tool result size, memory block size, and how
# many recent tool exchanges are replayed verbatim (older ones are collapsed).
TOOL_OUTPUT_MAX_CHARS=1600
MEMORY_MAX_CHARS=1200
HISTORY_KEEP_EXCHANGES=2

# Auto-compaction is evaluated against the complete request (system prompt +
# tool schemas + history). Eligibility starts at AUTO_COMPACT_MIN_TURNS user
# turns. It fires when the measured request exceeds AUTO_COMPACT_THRESHOLD and
# collapses older tool exchanges until AUTO_COMPACT_TARGET is reached.
# A value <= 1 is a fraction of the input budget; a larger value is an absolute
# token count. The newest tool exchange is always kept verbatim.
AUTO_COMPACT=1
AUTO_COMPACT_MIN_TURNS=2
AUTO_COMPACT_THRESHOLD=0.6
AUTO_COMPACT_TARGET=0.5

# --- Optional per-provider / per-model overrides ---------------------------
# Provider-prefixed names override the bundled metadata and the globals above:
#   NVIDIA_MAX_INPUT_TOKENS, NVIDIA_MAX_OUTPUT_TOKENS, NVIDIA_CONTEXT_WINDOW
#   NVIDIA_TPM, NVIDIA_RPM, NVIDIA_RPD, NVIDIA_TPD
# Model-specific names win over provider-prefixed ones (the model id is
# upper-cased and non-alphanumerics become underscores):
#   MODEL_MINIMAXAI_MINIMAX_M3_1_FLASH_MAX_OUTPUT_TOKENS=4096
#   MODEL_MINIMAXAI_MINIMAX_M3_1_FLASH_CONTEXT_WINDOW=131072
# A context window bounds input + reserved output; a TPM/RPD/TPD limit is
# enforced by the usage guard before a request is sent.

# --- Tokenizers ------------------------------------------------------------
# tiktoken is used automatically for known OpenAI families (gpt-oss, gpt-4o,
# gpt-4, ...). Other families fall back to an explicit chars/4 estimate. To use
# a compatible tokenizer, set one of:
#   TOKENIZER_DEFAULT=tiktoken:cl100k_base
#   TOKENIZER_MAP={"qwen/*": "tiktoken:cl100k_base"}
#   TOKENIZER_MINIMAXAI_MINIMAX_M3_1_FLASH=hf:some/repo
# Specs: tiktoken:<encoding>, approx[:chars_per_token], hf:<repo>, file:<path>.
# The hf:/file: forms require the optional `tokenizers` package; without it they
# degrade to the approximate tokenizer.
#
# The chars/4 fallback self-calibrates from provider-reported prompt tokens; the
# learned ratios are stored per provider/model in .agent/tokenizer.json. Set this
# to 0 to keep the fixed estimate.
TOKENIZER_CALIBRATION=1

# Ollama has no tokens-per-minute ceiling, only a context window.
OLLAMA_MAX_INPUT_TOKENS=32000

# MCP tool server: how long to wait for startup and for one tool call.
MCP_STARTUP_TIMEOUT=60
MCP_CALL_TIMEOUT=300

# OS sandbox around the tool server (optional). The launcher and its arguments
# are prepended to the server command:
#   MCP_SANDBOX_COMMAND=bwrap
#   MCP_SANDBOX_ARGS=["--ro-bind","/","/","--bind","/abs/workspace","/abs/workspace","--unshare-net","--"]
MCP_SANDBOX_COMMAND=
MCP_SANDBOX_ARGS=

# GET /models is a control-plane call; keep discovery snappy.
MODEL_DISCOVERY_TIMEOUT=20

# Or run with --debug-tokens to log approximate vs. reported usage per request.
DEBUG_TOKENS=0
